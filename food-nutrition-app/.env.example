# Environment variables for the NutritionDictionary web app.
# Copy to .env.local to override locally (never commit real values).

# Absolute path to the SQLite database. Defaults to ./nutrition.db relative to
# the server's working directory (the app dir for `next dev`/`next start`, the
# bundle dir for .next/standalone/server.js). Opened read-only.
# NUTRITION_DB_PATH=/absolute/path/to/nutrition.db

# Public site URL used for canonical/Open Graph metadata. Defaults to the production domain.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server port / bind address (next start uses -p; standalone server.js reads these)
# PORT=3000
# HOSTNAME=127.0.0.1

# Disable Next.js anonymous telemetry
# NEXT_TELEMETRY_DISABLED=1

# USDA FoodData Central API key: used only by the Python ingestion scripts in
# ../scripts, not by the web app. Get one at https://fdc.nal.usda.gov/api-key-signup.html
# USDA_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# Stripe LIVE mode (NutritionDictionary Plus subscription)
# STRIPE_MODE picks which set of Stripe settings the app uses:
#   live -> the STRIPE_* / NEXT_PUBLIC_STRIPE_* values in this section (real money)
#   test -> the STRIPE_TEST_* / NEXT_PUBLIC_STRIPE_TEST_* values further down
# Never put the secret key or webhook secret in a NEXT_PUBLIC_ variable:
# NEXT_PUBLIC_* values are sent to the browser.
#
# Live-key guard: a live key (sk_live_ / rk_live_) is refused unless NODE_ENV is
# production AND STRIPE_ALLOW_LIVE=1. `npm run dev`, `npm test` and `npm run preview`
# (a production build, but without the flag) never use live keys, so a laptop can't
# charge a real card by accident. Set STRIPE_ALLOW_LIVE=1 only on the production server.
# With no Stripe settings the site works and upgrade buttons say billing isn't set up.
# How to test: ../docs/STRIPE_PLAN.md §7.
# ---------------------------------------------------------------------------

STRIPE_MODE=test
# STRIPE_ALLOW_LIVE=

# Secret API key (server only).
# Dashboard -> Developers -> API keys -> "Secret key" (sk_test_...).
# Later, prefer a restricted key (rk_test_...) limited to Checkout, Customers,
# Subscriptions, Billing Portal, Invoices, Prices and Products.
STRIPE_SECRET_KEY=

# Publishable key (safe for the browser). Only needed for embedded Checkout;
# a redirect to Stripe-hosted Checkout works without it.
# Dashboard -> Developers -> API keys -> "Publishable key" (pk_test_...).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret (whsec_...). Used to verify events Stripe sends us.
# Local testing: run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# and copy the "whsec_..." it prints. Production: Dashboard -> Developers ->
# Webhooks -> your endpoint -> "Signing secret".
STRIPE_WEBHOOK_SECRET=

# Price IDs for the premium plan (price_...).
# Dashboard -> Product catalog -> Add product "NutritionDictionary Plus" with
# two recurring prices (planned: $5.99/month and $39.99/year), then copy each
# price's ID.
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=

# Optional: Customer Portal configuration ID (bpc_...). Leave empty to use the
# default portal settings (Dashboard -> Settings -> Billing -> Customer portal).
STRIPE_PORTAL_CONFIGURATION_ID=

# There is no card trial in Checkout: every new account gets a 14-day Plus trial in the
# app itself, with no card (lib/billing/entitlements.ts).

# Checkout's success and cancel links, and the portal's return link, use AUTH_BASE_URL
# (see the Auth section below; http://localhost:$PORT in development).

# ---------------------------------------------------------------------------
# Stripe TEST mode (used when STRIPE_MODE=test)
# Dashboard -> toggle "Test mode" (or open a Sandbox) -> Developers -> API keys.
# Test keys start with sk_test_ / rk_test_ / pk_test_. Test cards (4242 4242 4242 4242)
# never move real money. Price IDs and webhook secrets are different per mode,
# so create the "NutritionDictionary Plus" product again in test mode.
# In test mode each STRIPE_TEST_* falls back to its STRIPE_* name, which must then also
# hold a test key; a live key there is refused.
# ---------------------------------------------------------------------------
STRIPE_TEST_SECRET_KEY=
NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PRICE_PLUS_MONTHLY=
STRIPE_TEST_PRICE_PLUS_ANNUAL=
STRIPE_TEST_PORTAL_CONFIGURATION_ID=

# ---------------------------------------------------------------------------
# Auth (optional accounts). See ../docs/ACCOUNTS.md. Nothing here is needed for
# `npm run dev`: sign-in links print to the terminal and data goes in .data/app.db.
# Anonymous use never reads any of this.
# ---------------------------------------------------------------------------

# Public origin of the site. Used for sign-in links and the same-origin check.
# Defaults to http://localhost:$PORT in development. Must be https unless localhost.
# AUTH_BASE_URL=

# Signs session cookies and keys log pseudonyms. At least 32 characters, required
# unless AUTH_BASE_URL is localhost. Generate with: openssl rand -base64 32
# AUTH_SECRET=

# console prints sign-in links (localhost only); ses sends them through Amazon SES.
# Defaults to console in development and ses in production builds, so `npm run preview`
# needs AUTH_BASE_URL=http://localhost:PORT and AUTH_EMAIL_TRANSPORT=console.
# AUTH_EMAIL_TRANSPORT=
# AUTH_EMAIL_FROM=

# Optional Google sign-in. It is enabled only when both are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Comma-separated trusted headers holding the client IP, for rate limits. The default
# x-forwarded-for can be spoofed without a proxy in front. Behind CloudFront, use
# cloudfront-viewer-address.
# AUTH_IP_HEADERS=

# Where account data lives: sqlite (default) or dynamodb (default on Lambda).
# USER_STORE=
# Writable SQLite file, default .data/app.db. Never point this at nutrition.db.
# APP_DB_PATH=
# DynamoDB table for USER_STORE=dynamodb. The endpoint is only for local emulators.
# DYNAMODB_TABLE=
# DYNAMODB_ENDPOINT=
# AWS_REGION=

# ---------------------------------------------------------------------------
# AI: recipe analyzer (/recipes). See docs/RECIPES.md for setup and cost.
# With AI_PROVIDER unset the app uses the offline mock provider and never spends
# money, even if credentials are present.
# ---------------------------------------------------------------------------

# Which provider reads recipes: mock, bedrock or anthropic.
# AI_PROVIDER=

# Pasted text is read by the free built-in reader first, and goes to AI only when
# that read is unsure (lib/recipes/confidence.ts). off sends all pasted text to AI.
# AI_BUILTIN_TEXT=on

# Models (docs/RECIPES.md, "Which model reads what"). Set any of them to off to turn
# that tier off. Cost varies about 20x between Haiku and Sonnet.
#
# Main reader, for photos and for text the built-in reader is unsure of.
# Default: us.anthropic.claude-haiku-5-5 on Bedrock, claude-haiku-5-5 on the Claude API.
# On Bedrock, an inference profile id (us./global./eu./... before "anthropic.") or an
# ARN is sent to bedrock-runtime InvokeModel as written. A bare id such as
# claude-opus-5-5 gets "anthropic." added and goes to the bedrock-mantle endpoint,
# which doesn't serve every model (no Haiku 5.5 or Sonnet 5.5 in us-east-1 on
# 2026-11-13). A Nova id (us.amazon.nova-...) here makes Nova the main reader.
# AI_MODEL=
#
# Re-reads photos of plated food, and reads that fail validation.
# Default: us.anthropic.claude-sonnet-5-5 on Bedrock, claude-sonnet-5-5 on the Claude API.
# AI_ESCALATION_MODEL=
#
# Used only while Claude is unavailable (access denied, model not found, quota,
# throttling, outage). Bedrock only. Default: us.amazon.nova-2-lite-v1:0.
# us.amazon.nova-lite-v1:0 (Nova Lite v1) is about 8x cheaper but weaker.
# AI_FALLBACK_MODEL=

# Bedrock region, e.g. us-east-1; falls back to AWS_REGION, then AWS_DEFAULT_REGION
# (~/.aws/config is not read for this). Credentials come from the standard AWS chain:
# AWS_PROFILE or ~/.aws/credentials locally, the function's IAM role on Lambda. Never
# put access keys in this file.
# AI_BEDROCK_REGION=

# Claude API key (server only; never use a NEXT_PUBLIC_ name for it).
# ANTHROPIC_API_KEY=

# Timeout per attempt in ms, and SDK retries on connection errors, 429 and 5xx.
# AI_TIMEOUT_MS=
# AI_MAX_RETRIES=

# Abuse limits, per client IP. 0 turns a limit off. Counted per server instance.
# AI_RATE_LIMIT_PER_MINUTE=
# AI_RATE_LIMIT_PER_DAY=

# Stop calling the model once today's estimated spend reaches this many US dollars.
# 0 turns it off. Counted per server instance: also set an AWS Budget.
# AI_DAILY_BUDGET_USD=

# Largest photo upload, in bytes.
# AI_MAX_IMAGE_BYTES=

# Set to 1 to let the model re-rank low-confidence USDA matches (adds one call).
# AI_RERANK=
