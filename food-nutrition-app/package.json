    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/yonaadug/FoodNutritionOptimize.git"
    },
    "homepage": "https://github.com/yonaadug/FoodNutritionOptimize#readme",
    "bugs": {
        "url": "https://github.com/yonaadug/FoodNutritionOptimize/issues"
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "next dev",
        "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./lib/testing/register.mjs --test \"lib/**/*.test.ts\"",
        "build": "next build",
        "start": "next start",
        "start:standalone": "node scripts/standalone.mjs",
        "preview": "next build && node scripts/standalone.mjs",
        "smoke": "node scripts/smoke.mjs",
        "check": "npm run lint && npm run typecheck && npm test && npm run build",
        "lint": "eslint .",
        "typecheck": "next typegen && tsc --noEmit"
    },
    "dependencies": {
        "@anthropic-ai/bedrock-sdk": "1.1.1",
        "@anthropic-ai/sdk": "1.4.0",
        "@aws-sdk/client-dynamodb": "3.1162.0",
        "@aws-sdk/client-sesv2": "3.1162.0",
        "@aws-sdk/lib-dynamodb": "3.1162.0",
        "better-auth": "1.7.17",
        "better-sqlite3": "^13.0.3",
        "javascript-lp-solver": "^1.0.3",
        "jpeg-js": "0.4.4",
        "next": "^16.4.5",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "dynalite": "4.0.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.4.5",
        "typescript": "^6.0.3"
    },
    "overrides": {
        "@typescript-eslint/typescript-estree": {
            "minimatch": "^11.0.4"
        }
    }
}
