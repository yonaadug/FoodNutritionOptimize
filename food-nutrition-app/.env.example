# Environment variables for the Micronutrient Diary web app.
# Copy to .env.local to override locally (never commit real values).

# Absolute path to the SQLite database. Defaults to ./nutrition.db relative to
# the server's working directory (the app dir for `next dev`/`next start`, the
# bundle dir for .next/standalone/server.js). Opened read-only.
# NUTRITION_DB_PATH=/absolute/path/to/nutrition.db

# Public site URL used for canonical/Open Graph metadata. Defaults to the production domain.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server port / bind address (next start uses -p; standalone server.js reads these)
# PORT=3000
# HOSTNAME=127.0.0.1

# Disable Next.js anonymous telemetry
# NEXT_TELEMETRY_DISABLED=1

# USDA FoodData Central API key: used only by the Python ingestion scripts in
# ../scripts, not by the web app. Get one at https://fdc.nal.usda.gov/api-key-signup.html
# USDA_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# Stripe (Micronutrient Diary Plus subscription)
# Use TEST-mode values until launch (keys start with sk_test_ / pk_test_).
# Never put the secret key or webhook secret in a NEXT_PUBLIC_ variable:
# NEXT_PUBLIC_* values are sent to the browser.
# ---------------------------------------------------------------------------

# Secret API key (server only).
# Dashboard -> Developers -> API keys -> "Secret key" (sk_test_...).
# Later, prefer a restricted key (rk_test_...) limited to Checkout, Customers,
# Subscriptions, Billing Portal, Invoices, Prices and Products.
STRIPE_SECRET_KEY=

# Publishable key (safe for the browser). Only needed for embedded Checkout;
# a redirect to Stripe-hosted Checkout works without it.
# Dashboard -> Developers -> API keys -> "Publishable key" (pk_test_...).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret (whsec_...). Used to verify events Stripe sends us.
# Local testing: run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# and copy the "whsec_..." it prints. Production: Dashboard -> Developers ->
# Webhooks -> your endpoint -> "Signing secret".
STRIPE_WEBHOOK_SECRET=

# Price IDs for the premium plan (price_...).
# Dashboard -> Product catalog -> Add product "Micronutrient Diary Plus" with
# two recurring prices (planned: $5.99/month and $39.99/year), then copy each
# price's ID.
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=

# Optional: Customer Portal configuration ID (bpc_...). Leave empty to use the
# default portal settings (Dashboard -> Settings -> Billing -> Customer portal).
STRIPE_PORTAL_CONFIGURATION_ID=

# Optional: free-trial length in days for new subscriptions (e.g. 14). Empty = no trial.
STRIPE_TRIAL_DAYS=

# Base URL for Checkout success/cancel links. For local testing use:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
