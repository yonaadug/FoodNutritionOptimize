# syntax=docker/dockerfile:1
# =============================================================================
# EXAMPLE (built and run locally; never deployed to AWS): AWS Lambda container
# image for the Next.js standalone server, fronted by AWS Lambda Web Adapter.
# See docs/aws/AWS_HOSTING_DESIGN.md §2.2 Option A and docs/LOCAL_TESTING.md.
#
# Build context = the REPOSITORY ROOT (same as ./Dockerfile; the root
# .dockerignore keeps the context to food-nutrition-app/ only):
#
#   git lfs pull
#   docker build --platform linux/arm64 -f docs/aws/infra-example/Dockerfile.lambda -t nutrition-dictionary-lambda .
#   docker run --rm -p 3000:3000 nutrition-dictionary-lambda       # plain HTTP, adapter idle
#
# Lambda Web Adapter only activates inside the Lambda execution environment.
# Run as a plain container it is inert and the Next.js server answers HTTP
# directly, which is how we test the image locally.
#
# The image's architecture is whatever you build for: Lambda arm64 needs
# --platform linux/arm64 (native on Apple silicon); x86_64 Lambdas need
# --platform linux/amd64 (emulated on Apple silicon). Build on the target
# platform: the better-sqlite3 binary traced into the standalone bundle is
# the one for the build stage's platform.
# =============================================================================

ARG NODE_VERSION=26

# ---- deps --------------------------------------------------------------------
FROM node:${NODE_VERSION}-slim AS deps
WORKDIR /app
COPY food-nutrition-app/package.json food-nutrition-app/package-lock.json ./
# better-sqlite3 ships N-API prebuilds for linux-x64/arm64; --ignore-scripts
# stops npm from attempting a node-gyp source build (no toolchain needed).
RUN npm ci --no-audit --no-fund --ignore-scripts

# ---- build -------------------------------------------------------------------
FROM node:${NODE_VERSION}-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY food-nutrition-app/ ./
# In CI the pinned, checksum-verified DB from S3 is placed at
# food-nutrition-app/nutrition.db before the build; locally it is the Git LFS file.
RUN [ "$(head -c 15 nutrition.db)" = "SQLite format 3" ] \
    || { echo "nutrition.db is not a SQLite file (Git LFS pointer?). Run 'git lfs pull' first." >&2; exit 1; }
RUN npm run build && mkdir -p public

# ---- secrets loader ------------------------------------------------------------
# A start script that copies SSM SecureString parameters into the environment and
# then starts the server (lambda-secrets/start.mjs). Its own tiny dependency tree,
# so the app's package.json doesn't change.
FROM node:${NODE_VERSION}-slim AS secrets
WORKDIR /opt/secrets
COPY docs/aws/infra-example/lambda-secrets/package.json docs/aws/infra-example/lambda-secrets/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund --ignore-scripts
COPY docs/aws/infra-example/lambda-secrets/start.mjs ./

# ---- runtime -----------------------------------------------------------------
FROM node:${NODE_VERSION}-slim AS runtime
# Lambda Web Adapter runs as a Lambda extension and proxies invocations to the
# HTTP server. Pinned; check https://github.com/awslabs/aws-lambda-web-adapter/releases
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:1.1.0 /lambda-adapter /opt/extensions/lambda-adapter

WORKDIR /app
# HOSTNAME=0.0.0.0: on Lambda the adapter connects over loopback (any bind
# works); as a plain container the port must be reachable via `docker run -p`.
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    AWS_LWA_PORT=3000 \
    AWS_LWA_READINESS_CHECK_PATH=/api/meta \
    AWS_LWA_READINESS_CHECK_HEALTHY_STATUS=200-299 \
    NUTRITION_DB_PATH=/app/data/nutrition.db

COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
# Read-only nutrition DB at a fixed path (the standalone bundle also carries a
# traced copy at /app/nutrition.db; this one is what NUTRITION_DB_PATH uses).
COPY --from=build /app/nutrition.db /app/data/nutrition.db
COPY --from=secrets /opt/secrets /opt/secrets

# Lambda's filesystem is read-only except /tmp. Next only writes .next/cache
# for image optimization / ISR / the fetch cache, none of which this app uses;
# `docker run --read-only --tmpfs /tmp` (see docs/LOCAL_TESTING.md) checks that.
# Lambda runs the image as an arbitrary non-root user; files must be world-readable.
RUN chmod -R a+rX /app /opt/secrets
USER node

EXPOSE 3000
# With SSM_SECRETS unset (a plain `docker run`), start.mjs reads nothing and just
# starts server.js, so the image still runs offline.
CMD ["node", "/opt/secrets/start.mjs"]
