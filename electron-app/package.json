{
  "name": "nutricompare-desktop",
  "version": "1.0.0",
  "description": "NutriCompare - Desktop nutrition optimization application",
  "main": "main-standalone.js",
  "scripts": {
    "start": "unset ELECTRON_RUN_AS_NODE && NODE_ENV=development electron .",
    "start:prod": "unset ELECTRON_RUN_AS_NODE && NODE_ENV=production electron .",
    "start:standalone": "NODE_ENV=development electron main-standalone.js",
    "postinstall": "electron-rebuild",
    "prebuild": "cd ../food-nutrition-app && npm run build && mkdir -p ../electron-app/app && cp nutrition.db ../electron-app/app/nutrition.db",
    "build": "npm run prebuild && electron-builder",
    "build:mac": "npm run prebuild && electron-builder --mac",
    "build:win": "npm run prebuild && electron-builder --win",
    "build:linux": "npm run prebuild && electron-builder --linux",
    "package": "npm run prebuild && electron-builder --dir"
  },
  "build": {
    "appId": "com.nutricompare.app",
    "productName": "NutriCompare",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main-protocol.js",
      "main-standalone.js",
      "main-zero-network.js",
      "preload.js",
      "preload-ipc.js",
      "!main.js",
      "app/nutrition.db",
      {
        "from": "../food-nutrition-app/.next/standalone",
        "to": "app",
        "filter": [
          "**/*",
          "!nutrition.db"
        ]
      },
      {
        "from": "../food-nutrition-app/.next/static",
        "to": "app/.next/static"
      },
      {
        "from": "../food-nutrition-app/public",
        "to": "app/public"
      }
    ],
    "asar": false,
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "keywords": [
    "nutrition",
    "diet",
    "optimization",
    "health",
    "food",
    "usda"
  ],
  "author": "Yonathan Kebede <primeyonathan@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.5",
    "javascript-lp-solver": "^0.4.24",
    "next": "^16.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
