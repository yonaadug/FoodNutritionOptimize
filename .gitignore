env/
ENV/
.pytest_cache/

# Node.js / Next.js
node_modules/
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
# Regenerated by `next dev` / `next build` / `next typegen`
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Electron
electron-app/dist/
electron-app/staging/
*.dmg
*.exe
*.AppImage

# Environment variables & API keys (templates like .env.example stay tracked)
.env
.env.*
!.env.example
*.key
*.pem
api_keys.txt
usda_api_key.txt
config/*
!config/*.example

# Databases: ignored by default; the app DB is tracked through Git LFS
# (see .gitattributes)
*.db
*.sqlite
*.sqlite3
!food-nutrition-app/nutrition.db

# Data directories (raw USDA downloads are large and re-downloadable)
data/raw/
data/csv/
FoodData_Central_*/
*.csv
!data/samples/*.csv

