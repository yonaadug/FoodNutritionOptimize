{
  "name": "nutricompare-desktop",
  "productName": "NutriCompare",
  "version": "1.0.0",
  "description": "NutriCompare - Desktop nutrition optimization application",
  "main": "main.js",
  "scripts": {
    "start": "unset ELECTRON_RUN_AS_NODE && electron .",
    "start:prod": "npm run stage && unset ELECTRON_RUN_AS_NODE && NUTRICOMPARE_USE_STAGED=1 electron .",
    "stage": "npm --prefix ../food-nutrition-app run build && node scripts/stage-web.js",
    "pack": "npm run stage && electron-builder --dir",
    "build": "npm run stage && electron-builder",
    "build:mac": "npm run stage && electron-builder --mac",
    "build:win": "npm run stage && electron-builder --win",
    "build:linux": "npm run stage && electron-builder --linux"
  },
  "build": {
    "appId": "com.nutricompare.app",
    "productName": "NutriCompare",
    "directories": {
      "app": ".",
      "output": "dist"
    },
    "files": [
      "main.js",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "staging",
        "to": ".",
        "filter": [
          "web/**/*"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "keywords": [
    "nutrition",
    "diet",
    "optimization",
    "health",
    "food",
    "usda"
  ],
  "author": "Yonathan Kebede <primeyonathan@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
